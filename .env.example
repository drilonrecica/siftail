# Required public addresses. The ingestion URL must include /api/v1/ingest.
SIFTAIL_PUBLIC_URL=http://127.0.0.1:8080
SIFTAIL_INGEST_PUBLIC_URL=http://127.0.0.1:8081/api/v1/ingest

# Optional image and runtime settings.
# SIFTAIL_IMAGE=ghcr.io/drilonrecica/siftail:0.5.0
# SIFTAIL_LOG_LEVEL=info
# SIFTAIL_LOG_FORMAT=text
# SIFTAIL_SHUTDOWN_TIMEOUT=30s
# SIFTAIL_STOP_GRACE_PERIOD=40s

# Leave empty unless requests actually pass through these proxy networks.
# Never use a broad value such as 0.0.0.0/0 or ::/0.
SIFTAIL_TRUSTED_PROXY_CIDRS=

# Optional loopback publication used only with compose.local.yaml.
# SIFTAIL_LOCAL_UI_BIND=127.0.0.1
# SIFTAIL_LOCAL_UI_PORT=8080
# SIFTAIL_LOCAL_INGEST_BIND=127.0.0.1
# SIFTAIL_LOCAL_INGEST_PORT=8081
