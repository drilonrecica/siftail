# Required public addresses. `siftail serve` refuses to start without
# SIFTAIL_PUBLIC_URL: it is the exact browser origin (no path, query, or
# credentials) and alone decides origin checks and cookie security. Use the
# https origin in production: Siftail then sets Secure __Host- cookies and
# HSTS. http is meant for loopback or private access only.
# The ingestion URL must include /api/v1/ingest.
SIFTAIL_PUBLIC_URL=http://127.0.0.1:8080
SIFTAIL_INGEST_PUBLIC_URL=http://127.0.0.1:8081/api/v1/ingest

# Optional image and runtime settings.
# COMPOSE_SIFTAIL_IMAGE=ghcr.io/drilonrecica/siftail:0.5.0
# SIFTAIL_LOG_LEVEL=info
# SIFTAIL_LOG_FORMAT=text
# SIFTAIL_SHUTDOWN_TIMEOUT=30s
# Browser backups write and verify only plain file names in this directory;
# the CLI still accepts any path. Must not be the data directory itself.
# SIFTAIL_BACKUP_DIR=/data/backups
# COMPOSE_SIFTAIL_STOP_GRACE_PERIOD=40s

# Leave empty unless requests actually pass through these proxy networks.
# Never use a broad value such as 0.0.0.0/0 or ::/0.
SIFTAIL_TRUSTED_PROXY_CIDRS=

# Optional loopback publication used only with compose.local.yaml.
# COMPOSE_SIFTAIL_LOCAL_UI_BIND=127.0.0.1
# COMPOSE_SIFTAIL_LOCAL_UI_PORT=8080
# COMPOSE_SIFTAIL_LOCAL_INGEST_BIND=127.0.0.1
# COMPOSE_SIFTAIL_LOCAL_INGEST_PORT=8081

# No secret variable exists in this release, and none belongs in this file.
# A future secret SIFTAIL_X will also accept SIFTAIL_X_FILE (never both): an
# absolute path, such as a Compose secret at /run/secrets/siftail_x, to a
# regular file of at most 64 KiB that is not group- or world-writable.
# Trailing CR/LF is removed (ADR 0010). Any SIFTAIL_*_FILE set today is an
# unknown variable and startup fails. See docs/operations/docker-compose.md,
# "Secret files (_FILE)".
